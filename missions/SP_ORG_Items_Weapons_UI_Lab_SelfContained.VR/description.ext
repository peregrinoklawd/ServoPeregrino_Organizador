author = "Claudio Malta Telhada";
onLoadName = "SP_ORG UI Lab - UICommon 0.2-D R2";
onLoadMission = "UICommon 0.2-D R2: polish visual compartilhado com buscas compactas, superficies suaves e convergencia de footer/Meus Kits sem alterar comportamento.";
overviewText = "Items + Weapons preservados; UICommon 0.2-D R2 aplica polish visual compartilhado mantendo IDs, eventos, DnD, buscas e refresh contracts.";
enableDebugConsole = 1;
disabledAI = 1;
respawn = 3;
respawnDelay = 2;
respawnOnStart = -1;

class Header
{
    gameType = COOP;
    minPlayers = 1;
    maxPlayers = 8;
};

