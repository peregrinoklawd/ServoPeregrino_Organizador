author = "Claudio Malta Telhada";
onLoadName = "SP_ORG Items + Weapons UI Lab - Self Contained";
onLoadMission = "Laboratorio mission-first sem dependencia de PBO do Servo Peregrino.";
overviewText = "Nexus + UICommon + Items carregados diretamente pela missao. Weapons 0.6 sera incorporado quando a candidata correta for recuperada/reconstruida.";
enableDebugConsole = 1;
disabledAI = 1;
respawn = 3;
respawnDelay = 2;
respawnOnStart = -1;

class Header
{
    gameType = COOP;
    minPlayers = 1;
    maxPlayers = 8;
};

